# Ignore backup and temporary files
*.old
*.orig
*.swp
*.tmp

# .vscode
.vscode

# Original reference files
orig.*
ref.*

# ghdl config file
*.cf 

# work, venv and gen folders
work
gen
gen_axis
venv*

# compiled test binaries, removed by "make clean"
tests/c/*/tb
tests/hdl/*/tb

# python bytecode, the host side tests import the driver on every run
__pycache__/
*.pyc

# Simulation output
*.vcd
*.ghw

# GUI screenshots, regenerated by "make shots" in tests/python/05_gui
tests/python/05_gui/shots/

# Events log
events_log*

# Python driver captures
capture/

# Report-writing
report_staging/

# .tex
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.nav
*.out
*.snm
*.toc
*.lof
*.lot
*.synctex.gz
*.vrb
*.bcf
*.run.xml
docs/tex/*.pdf
docs/tex/chapters/*.pdf
docs/tex/appendices/*.pdf
docs/tex/images/*_converted.pdf
